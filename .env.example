# ================= Ethereum

ETHEREUM_RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# ================= Tendermint

TENDERMINT_RPC_URL=
TENDERMINT_GRPC_URL=
TENDERMINT_GRPC_BASIC_AUTH=

# ================= SP1

# If you're using the Succinct network, set SP1_PROVER to "network". Otherwise, set it to "cpu" or "mock".
SP1_PROVER=cpu
# Only required if SP1_PROVER is set to "network".
NETWORK_PRIVATE_KEY=
# Succinct hosted network rpc
NETWORK_RPC_URL=https://rpc.production.succinct.xyz
# (Optional) The duration of a ZK proof before it times out
SP1_TIMEOUT_MINS=

# ================= Miscellaneous

# Minimum number of blocks to submit in a commitment
MINIMUM_BLOCK_RANGE=1024
# Logging information info/debug
RUST_LOG=info
# Time to sleep before the docker container is restarted
TIME_TO_SLEEP_IN_MINUTES=30